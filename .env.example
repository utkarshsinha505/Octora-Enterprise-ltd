# Copy to .env.local for local development, and add the same keys in Vercel → Settings → Environment Variables.

# Canonical site URL (used for SEO, sitemap and social cards)
NEXT_PUBLIC_SITE_URL=https://www.yourdomain.com

# Contact form email delivery via https://resend.com
RESEND_API_KEY=
CONTACT_TO_EMAIL=hello@yourdomain.com
CONTACT_FROM_EMAIL="UPÉ Website <website@yourdomain.com>"
